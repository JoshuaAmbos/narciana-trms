APP_NAME="Narciana TRMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=narciana
DB_USERNAME=root
DB_PASSWORD=
# Manila time for NOW()/CURRENT_TIMESTAMP inside MySQL
DB_TIMEZONE=+08:00

# Backups (Module 9b). XAMPP paths below; on Namecheap use BACKUP_MYSQLDUMP_PATH=mysqldump and BACKUP_MYSQL_PATH=mysql
BACKUP_MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
BACKUP_MYSQL_PATH=C:/xampp/mysql/bin/mysql.exe

SESSION_DRIVER=database
# Minutes of inactivity before the user is logged out (decision 6)
SESSION_LIFETIME=15
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Passwords for the first Owner / Manager / Caretaker accounts (used only by `php artisan db:seed`).
# Leave blank to have a random password generated and printed once. Change them after first login.
SEED_OWNER_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_CARETAKER_PASSWORD=
